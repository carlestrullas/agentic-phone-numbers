{$DOMAIN} {
	encode gzip

	# Order webhook (ElevenLabs tool). n8n validates the token.
	handle /webhook/pizzeria/pedido {
		@no_post not method POST
		respond @no_post 405

		request_body {
			max_size 64KB
		}
		reverse_proxy n8n:5678
	}

	# Order board (the app itself asks for the login)
	handle {
		reverse_proxy frontend:8080 {
			flush_interval -1 # real time (SSE)
		}
	}
}
