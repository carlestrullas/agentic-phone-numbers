# Copia este archivo a .env (o ejecuta `make init`, que ademas genera los secretos).
# El .env NUNCA se sube a Git.

# --- Entorno ---------------------------------------------------------------
# Local:     docker-compose.yml:docker-compose.local.yml
# Servidor:  docker-compose.yml:docker-compose.prod.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
COMPOSE_PROJECT_NAME=phone-orders
TZ=Europe/Madrid

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=pizzeria
POSTGRES_PASSWORD=
POSTGRES_DB=pizzeria

# --- n8n -------------------------------------------------------------------
N8N_VERSION=2.40.7
# Cifra las credenciales guardadas en n8n. No la cambies una vez arrancado.
N8N_ENCRYPTION_KEY=
# Token que ElevenLabs envia en la cabecera X-Pizzeria-Token
PIZZERIA_WEBHOOK_TOKEN=

# --- Panel de comandas -----------------------------------------------------
PANEL_USER=cocina
# En local puede quedar vacio (sin login). En el servidor es obligatorio.
PANEL_PASSWORD=

# --- Puertos en local (opcional) -------------------------------------------
# POSTGRES_PORT=5432
# N8N_PORT=5678
# FRONTEND_PORT=8081

# --- Solo servidor ---------------------------------------------------------
DOMAIN=pedidos.example.com

# --- ElevenLabs (opcional, para `make agent-export`) -----------------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
