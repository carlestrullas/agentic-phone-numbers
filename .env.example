# Copy this file to .env (or run `make init`, which also generates the secrets).
# .env is NEVER committed to Git.

# --- Environment -----------------------------------------------------------
# Local:   docker-compose.yml:docker-compose.local.yml
# Server:  docker-compose.yml:docker-compose.prod.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
COMPOSE_PROJECT_NAME=phone-orders
TZ=Europe/Madrid

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=pizzeria
POSTGRES_PASSWORD=
POSTGRES_DB=pizzeria

# --- n8n -------------------------------------------------------------------
N8N_VERSION=2.40.7
# Encrypts the credentials stored in n8n. Do not change it once n8n has started.
N8N_ENCRYPTION_KEY=
# Token ElevenLabs sends in the X-Pizzeria-Token header
PIZZERIA_WEBHOOK_TOKEN=

# --- Order board -----------------------------------------------------------
PANEL_USER=kitchen
# Can be empty locally (no login). Required on the server.
PANEL_PASSWORD=

# --- Local ports (optional) ------------------------------------------------
# POSTGRES_PORT=5432
# N8N_PORT=5678
# FRONTEND_PORT=8081

# --- Server only -----------------------------------------------------------
DOMAIN=orders.example.com

# --- ElevenLabs (optional, for `make agent-export`) ------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
